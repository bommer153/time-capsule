# Database (MongoDB Atlas)
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster.mongodb.net/time-capsule?appName=tabulation"

# Bunny Seer — peek sealed messages, delete, import unlock date
VAULT_ADMIN_USERNAME="seer"
VAULT_ADMIN_PASSWORD="change-me-seer"

# Capsule Courier — export encrypted JSON, delete
EXPORT_ADMIN_USERNAME="courier"
EXPORT_ADMIN_PASSWORD="change-me-courier"

# Optional fallback (treated as vault/seer if set)
# ADMIN_USERNAME="admin"
# ADMIN_PASSWORD="change-me"

# 32+ character secret for session cookies
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Used to encrypt/decrypt export JSON
CAPSULE_EXPORT_KEY="replace-with-a-strong-export-passphrase"
